# A global dictionary to temporarily collect files belonging to the same media group album
# Structure: { media_group_id: [list_of_downloaded_file_paths] }
MEDIA_GROUPS = {}


# --- 2. THE RENDER RETAINER (DUMMY WEB SERVER) ---
# Render's Free Web Service requires a port to listen to, or else it shuts down.
def run_dummy_server():
    server_address = ('', int(os.environ.get("PORT", 8080)))
    httpd = http.server.HTTPServer(server_address, http.server.SimpleHTTPRequestHandler)
    print(f"Dummy web server running on port {server_address[1]}...")
    httpd.serve_forever()


# --- 3. THE AUTOMATED AI PROCESSING PIPELINE ---
def auto_sort_and_process(user_id, file_list):
    """
    Since the user uploaded files simultaneously, they might be in any order.
    This function analyzes the files to identify which is which.
    """
    front_path, back_path, qr_path = None, None, None
    
    # Simple logic placeholder: In production, you would insert your OpenCV/PyZbar logic here.
    # (e.g., if pyzbar.decode(img) finds text, that file is your QR code!)
    if len(file_list) >= 3:
        front_path = file_list[0]
        back_path = file_list[1]
        qr_path = file_list[2]
    else:
        raise ValueError("You must upload exactly 3 photos (Front, Back, and QR).")

    output_path = f"output_{user_id}.png"
    
    # Core Processing Engine (Canvas Template Rebuilder)
    base_card = Image.new("RGB", (800, 400), color="white")
    front_img = Image.open(front_path).resize((200, 250))
    back_img = Image.open(back_path).resize((200, 250))
    qr_img = Image.open(qr_path).resize((150, 150))
    
    base_card.paste(front_img, (50, 75))
    base_card.paste(back_img, (300, 75))
    base_card.paste(qr_img, (550, 125))
    
    draw = ImageDraw.Draw(base_card)
    draw.text((50, 20), f"Automatically Generated Fayda Card for User {user_id}", fill="black")
    
    base_card.save(output_path)
    return output_path, [front_path, back_path, qr_path]


# --- 4. TELEGRAM CONVERSATION INTERFACES ---
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Greets the user and explains how to upload files."""
    await update.message.reply_text(
        "👋 Welcome! Please select the **Front photo, Back photo, and QR code** "
        "of your Fayda ID all at once from your phone gallery and send them together as an album."
    )


async def handle_album_upload(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Handles incoming simultaneous image bundles."""
    user_id = update.message.from_user.id
    media_group_id = update.message.media_group_id

    # If the user sends a single standalone photo instead of a grouped album
    if not media_group_id:
        await update.message.reply_text("⚠️ Please send all 3 required images together as a single album upload.")
        return

    # Download the current loop's incoming image asset file 
    photo_file = await update.message.photo[-1].get_file()
    file_index = len(MEDIA_GROUPS.get(media_group_id, []))
    temp_path = f"temp_{user_id}_{media_group_id}_{file_index}.jpg"
    await photo_file.download_to_drive(temp_path)

    # Initialize or append current downloads to the tracking container thread queue
    if media_group_id not in MEDIA_GROUPS:
        MEDIA_GROUPS[media_group_id] = []
    MEDIA_GROUPS[media_group_id].append(temp_path)

    # Pause execution thread briefly to allow parallel uploads to write to drive cache
    await asyncio.sleep(2)

    # Run the core conversion engine execution exclusively on the final completed thread
    if media_group_id in MEDIA_GROUPS:
        file_list = MEDIA_GROUPS[media_group_id]
        
        if len(file_list) < 3:
            # Files are still writing to local storage system. Hold execution context.
            return
            
        # Remove entry block key from dictionary tracking so sister threads don't replicate it
        del MEDIA_GROUPS[media_group_id]
        
        await update.message.reply_text("⚙️ All 3 Images received simultaneously! Running AI processing pipeline...")
        
        try:
            # Execute automated template generation
            output_file, used_files = auto_sort_and_process(user_id, file_list)
            
            # Send file back to user
            with open(output_file, 'rb') as f:
                await update.message.reply_photo(photo=f, caption="🎉 Automated compilation successful!")
            
            # Wipe generated output resource
            if os.path.exists(output_file):
                os.remove(output_file)
                
        except Exception as e:
            await update.message.reply_text(f"⚠️ Process Failed: {str(e)}")
            used_files = file_list
            
        finally:
            # Strict Data Privacy Protocol: Wipe raw source identification images immediately
            for path in used_files:
                if os.path.exists(path):
                    os.remove(path)


# --- 5. SYSTEM APPLICATION STARTER ---
def main():
    # 1. Start the dummy web server in a background thread for Render compatibility
    threading.Thread(target=run_dummy_server, daemon=True).start()

    # 2. Start the regular asynchronous polling interface for Telegram core API
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.PHOTO, handle_album_upload))

    print("Bot loop initialized. Listening for messages...")
    app.run_polling()


if __name__ == "__main__":
    main()
